# Copy to .env and fill in. .env is gitignored; never commit it.
SNOWFLAKE_ACCOUNT=                      # e.g. ABCDEFG-XY12345 (Snowsight: your name > Account > copy identifier)
SNOWFLAKE_USER=AIRFLOW_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_rsa_key.p8
SNOWFLAKE_ROLE=RETAIL_LOADER
SNOWFLAKE_WAREHOUSE=RETAIL_WH
SNOWFLAKE_DATABASE=RETAIL
SNOWFLAKE_SCHEMA=RAW
SOCRATA_APP_TOKEN=                      # optional; raises the data.iowa.gov rate limit
