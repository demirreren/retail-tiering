# Copy to .env and fill in. .env is gitignored; never commit it.
# Account identifier: Snowsight > your name (bottom left) > Account > copy identifier. Looks like ABCDEFG-XY12345
SNOWFLAKE_ACCOUNT=
# Service user created by snowflake/setup.sql; logs in with the key pair, no password.
SNOWFLAKE_USER=AIRFLOW_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_rsa_key.p8
SNOWFLAKE_ROLE=RETAIL_LOADER
SNOWFLAKE_WAREHOUSE=RETAIL_WH
SNOWFLAKE_DATABASE=RETAIL
SNOWFLAKE_SCHEMA=RAW

# Phase 3 assistant: read-only Snowflake user created by snowflake/setup_reader.sql, and the Claude API key
SNOWFLAKE_READER_USER=ASSISTANT_SVC
SNOWFLAKE_READER_ROLE=RETAIL_READER
SNOWFLAKE_READER_KEY_PATH=.secrets/assistant_rsa_key.p8
ANTHROPIC_API_KEY=
